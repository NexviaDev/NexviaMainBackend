# 공공데이터포털 > 마이페이지 > 인증키
# "조달청_나라장터 입찰공고정보서비스" 활용신청 후 발급받은 일반 인증키(UTF-8) 원문을 넣습니다.
DATA_GO_KR_SERVICE_KEY=

# 기본값: https://apis.data.go.kr/1230000/ad/BidPublicInfoService
# 구버전 엔드포인트가 필요하면 https://apis.data.go.kr/1230000/BidPublicInfoService 로 변경
BID_PUBLIC_INFO_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService

# 조달청 「나라장터 낙찰정보서비스」(참고문서 1.1) — 입찰공고와 별도 데이터셋. End Point 는 ScsbidInfoService 입니다.
# OPENG_RESULT_BASE_URL 에는 URL 만 넣고, 인증키는 DATA_GO_KR_SERVICE_KEY 에만 넣으세요.
# 낙찰 upstream 기본은 serviceKey 만 전달합니다. 403 이 나면 OPENG_AUTH_QUERY=ServiceKey 또는 both 로 바꿔 보세요.
# OPENG_AUTH_QUERY=serviceKey
OPENG_RESULT_BASE_URL=https://apis.data.go.kr/1230000/as/ScsbidInfoService

# 나라장터 사전규격정보 — 포털에서 별도 활용신청 후 사용. 기본 End Point(미신청 시 오류).
# PRESPEC_BASE_URL=https://apis.data.go.kr/1230000/ao/HrcspSsstndrdInfoService
# 인증 쿼리: ServiceKey(기본) | serviceKey | both — Unexpected errors 시 serviceKey 로 바꿔 보세요.
# PRESPEC_AUTH_QUERY=ServiceKey

# 나라장터 발주계획현황 — 포털에서 별도 활용신청 후 사용.
# ORDR_PLAN_BASE_URL=https://apis.data.go.kr/1230000/ao/OrderPlanSttusService
# ORDR_PLAN_AUTH_QUERY=serviceKey

# 기업마당(www.bizinfo.go.kr) 정책정보 개방 > 지원사업정보 API(bizinfoApi.do) 인증키(crtfcKey)
# 발급 후 허용 IP/URL 등록이 필요할 수 있습니다.
BIZINFO_CRTFC_KEY=

# 기본: https://www.bizinfo.go.kr/uss/rss/bizinfoApi.do
# BIZINFO_API_URL=

# 기업마당 행사·교육 API (기본 bizinfoEventApi.do)
# BIZINFO_EVENT_API_URL=

# Google AI Studio — Gemini API (식물 식별 /api/v1/plants/identify)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: gemini-2.5-flash (기본), gemini-2.5-flash-lite 등
# GEMINI_MODEL=gemini-2.5-flash

# 백엔드 API 포트 (기본 5001). 충돌 시 5002 등으로 변경
PORT=5001

# Gmail(nodemailer) — 회원가입·로그인 인증번호 발송
EMAIL_USER=
EMAIL_PASS=

# MongoDB — 회원가입·로그인 (Atlas 연결 문자열)
MONGODB_URI=
MONGODB_DB=nexvia

# 로그인 JWT 서명 키 (32자 이상 랜덤 문자열 권장)
AUTH_JWT_SECRET=

# 개발 전용: true 이면 인증번호를 API 응답·화면에 표시 (운영에서는 false)
AUTH_DEV_EXPOSE_CODE=true

# 입찰·사전규격 서버 캐시 — GET /api/v1/cache/warm?token=... (수동)
# 서버 기동 시 매시 :20·:50 자동 갱신 (CACHE_WARM_SCHEDULE=0 으로 끄기)
CACHE_WARM_TOKEN=
CACHE_WARM_SCHEDULE=1
